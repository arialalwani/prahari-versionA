# Copy to .env. Never commit .env.

APP_HOST=127.0.0.1
APP_PORT=8080
JUDGE_USER=judge
JUDGE_PASSWORD=set-this-before-submit
ADMIN_USER=admin
ADMIN_PASSWORD=admin
VIEWER_HOME=home.viewer
VIEWER_PASSWORD=viewer
AUDITOR_USER=auditor
AUDITOR_PASSWORD=auditor
SECRET_KEY=change-me
MAX_OPEN_CAPTURES=4
ANPR_ENGINE=tesseract
# Which reader turns the plate crop into characters, independent of how
# the crop is found. tesseract (subprocess, document OCR) or easyocr
# (in-process, scene-text; needs pip install easyocr).
OCR_ENGINE=tesseract
ANALYTICS_ENGINES=anpr,objects
# Person detection is YOLO only (needs requirements-vision.txt). Any other
# value turns it off; there is no heuristic fallback.
OBJECT_ENGINE=yolo
# Intrusion alerts need a YOLO person at or above this confidence.
INTRUSION_MIN_CONFIDENCE=0.5
# Person tracking: link a detection to a track if box overlap (IoU) >= 1 - this.
# 0.9 was tuned on 10 fps footage; raise towards 0.95 for lower frame rates.
TRACK_MATCH_THRESH=0.9
# histogram = face identification OFF: colour histograms are not face
# recognition. A real recogniser arrives in Phase 2 of the face upgrade.
FACE_ENGINE=histogram
TRACK_ENGINE=iou
FACE_DIR=data/faces
# Optional vision extras (pip install -r requirements-vision.txt). Defaults need no GPU.
# ANPR_ENGINE=yolo
# FACE_ENGINE=facenet
# TRACK_ENGINE=bytetrack
# YOLO_VEHICLE_WEIGHTS=app/models_data/yolov8n.pt

# Leave empty until Resources login yields a host. Platform must boot without it.
SENTINEL_HOST=
SENTINEL_CATALOGUE_PATH=/cameras.json
SENTINEL_USER=
SENTINEL_PASSWORD=
SENTINEL_RTSP_HOST=

# Capture
RTSP_TRANSPORT=tcp
RECONNECT_MIN_S=2
RECONNECT_MAX_S=30
SAMPLE_FPS=1
ANPR_MIN_CONFIDENCE=0.35

# Paths
DB_PATH=data/prahari.db
CROP_DIR=data/crops

# Optional. Set only if tesseract.exe is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Catalogue HTTP timeout in seconds. Raise if the sandbox is slow.
# SENTINEL_TIMEOUT_S=60
